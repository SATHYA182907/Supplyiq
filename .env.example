# SUPPLYIQ Environment Variables

# Server Configuration
PORT=8000
ENVIRONMENT=development
DEMO_MODE=true

# Database (Supabase PostgreSQL / PostGIS / pgvector)
# When unset, defaults to local SQLite engine (./supplyiq.db) with 100% functionality
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI & LLM Providers
# Optional: Used for grounded natural-language ranking explanations
GEMINI_API_KEY=

# AI Matching Engine Thresholds
STRONG_MATCH_THRESHOLD=94.0
POSSIBLE_MATCH_THRESHOLD=75.0
GEO_TOLERANCE_METERS=350.0
